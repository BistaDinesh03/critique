# GitHub OAuth (optional — enables "Login with GitHub")
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Security
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here
SESSION_COOKIE_SECURE=false
# Session lifetime in seconds (optional; default 604800 = 7 days)
# SESSION_COOKIE_MAX_AGE=604800

# Database
# Local development (SQLite):
# DATABASE_URL=sqlite:///./critique.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/database_name

# Email magic links via Resend (optional — enables "Continue with email")
# RESEND_API_KEY=re_your_api_key_here
# EMAIL_FROM=login@example.com

# App settings
APP_ENV=development
APP_URL=http://127.0.0.1:8000
